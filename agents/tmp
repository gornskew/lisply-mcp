#!/usr/bin/env python3
"""
Generic MCP Agent with Ollama and Terminal Interface

A simple terminal-based agent that uses Ollama for local LLM inference
and connects to MCP servers defined in mcp-config.json.
"""

import asyncio
import json
import os
import sys
from pathlib import Path
from typing import Dict, Any, Optional, List, Tuple

import aiohttp
from dotenv import load_dotenv
from langchain_ollama import ChatOllama
from langchain.prompts import ChatPromptTemplate
from mcp_use import MCPAgent, MCPClient


class OllamaMCPAgent:
    """Terminal-based MCP agent using Ollama."""
    
    def __init__(self, 
                 config_path: str = "mcp-config.json",
                 model_name: str = "llama3.2",
                 ollama_base_url: str = "http://localhost:11434",
                 max_steps: int = 10,
                 verbose: bool = True):
        """
        Initialize the Ollama MCP Agent.
        
        Args:
            config_path: Path to mcp-config.json file
            model_name: Ollama model name (e.g., 'llama3.2', 'mistral', 'codellama')
            ollama_base_url: Ollama server URL
            max_steps: Maximum steps for agent execution
            verbose: Enable verbose logging
        """
        self.config_path = config_path
        self.model_name = model_name
        self.ollama_base_url = ollama_base_url
        self.max_steps = max_steps
        self.verbose = verbose
        
        self.client: Optional[MCPClient] = None
        self.agent: Optional[MCPAgent] = None
        self.llm: Optional[ChatOllama] = None
    
    async def initialize(self) -> bool:
        """Initialize the agent with MCP servers and LLM."""
        try:
            # Load MCP configuration
            if not await self._load_mcp_config():
                return False
            
            # Initialize Ollama LLM
            if not await self._initialize_llm():
                return False
            
            # Create MCP agent
            if not await self._create_agent():
                return False
            
            print(f"✅ Agent initialized successfully!")
            print(f"   Model: {self.model_name}")
            print(f"   MCP Servers: {list(self.client.config.get('mcpServers', {}).keys())}")
            return True
            
        except Exception as e:
            print(f"❌ Failed to initialize agent: {e}")
            return False


    async def _load_mcp_config(self) -> bool:
        """Load and validate MCP configuration from JSON file."""
        try:
            config_file = Path(self.config_path)
            if not config_file.exists():
                print(f"❌ Config file not found: {self.config_path}")
                return False
            
            with open(config_file, 'r') as f:
                config = json.load(f)
                
                # Validate config structure
                if not isinstance(config, dict):
                    print(f"❌ Config file must contain a JSON object")
                    return False
                
                if 'mcpServers' not in config:
                    print(f"❌ Config file missing 'mcpServers' section")
                    return False
                
                servers = config['mcpServers']
                if not isinstance(servers, dict) or not servers:
                    print(f"❌ 'mcpServers' must be a non-empty object")
                    return False
                
                # Validate each server configuration
                for server_name, server_config in servers.items():
                    if not isinstance(server_config, dict):
                        print(f"❌ Server '{server_name}' config must be an object")
                        return False
                    
                    has_command = 'command' in server_config
                    has_url = 'url' in server_config
                    
                    if not (has_command or has_url):
                        print(f"❌ Server '{server_name}' must have either 'command' or 'url'")
                        return False
                    
                    if has_command and not server_config['command']:
                        print(f"❌ Server '{server_name}' command cannot be empty")
                        return False
                    
                    if has_url and not server_config['url']:
                        print(f"❌ Server '{server_name}' url cannot be empty")
                        return False
                    
                    # Create MCP client from config
                    self.client = MCPClient.from_dict(config)
                    print(f"✅ Loaded and validated MCP config from {self.config_path}")
                    print(f"   Found {len(servers)} server(s): {', '.join(servers.keys())}")
                    
                    # Debug session creation
                    print(f"🔍 Checking sessions after client creation...")
                    if hasattr(self.client, 'sessions'):
                        print(f"   Sessions: {list(self.client.sessions.keys())}")
                        if not self.client.sessions:
                            print(f"⚠ No sessions created. Attempting to initialize sessions...")
                            try:
                                async with asyncio.timeout(10):
                                    for server_name in servers:
                                        print(f"   Initializing session for {server_name}...")
                                        # Assuming MCPClient has an async method to initialize sessions
                                        if hasattr(self.client, 'initialize_session'):
                                            await self.client.initialize_session(server_name)
                                        else:
                                            print(f"⚠ MCPClient does not support initialize_session method")
                                            print(f"   Sessions after initialization: {list(self.client.sessions.keys())}")
                            except Exception as e:
                                print(f"❌ Failed to initialize sessions: {e}")
                                return False
                            else:
                                print(f"❌ MCPClient does not have sessions attribute")
                                return False
                            
                            return True
                        
        except json.JSONDecodeError as e:
            print(f"❌ Invalid JSON in config file: {e}")
            return False
        except Exception as e:
            print(f"❌ Failed to load MCP config: {e}")
            return False        
    
    
    async def _initialize_llm(self) -> bool:
        """Initialize Ollama LLM with model verification."""
        try:
            # Check available models first
            print(f"🔍 Checking available Ollama models...")
            async with asyncio.timeout(10):  # 10-second timeout
                async with aiohttp.ClientSession() as session:
                    async with session.get(f"{self.ollama_base_url}/api/tags") as resp:
                        if resp.status != 200:
                            print(f"❌ Failed to connect to Ollama: HTTP {resp.status}")
                            print(f"   Make sure Ollama is running at {self.ollama_base_url}")
                            return False
                        
                        data = await resp.json()
                        models = data.get("models", [])
                        available_models = [m["name"] for m in models]
                        
                        if not any(model.startswith(self.model_name) for model in available_models):
                            print(f"❌ Model '{self.model_name}' not found.")
                            print(f"   Available models: {available_models}")
                            print(f"   Try: ollama pull {self.model_name}")
                            return False
                        
                        print(f"✅ Model '{self.model_name}' is available")
            
            # Initialize LLM
            async with asyncio.timeout(15):  # 15-second timeout for initialization
                self.llm = ChatOllama(
                    model=self.model_name,
                    base_url=self.ollama_base_url,
                    temperature=0.7,
                )
                
                # Test connection to Ollama
                print(f"🔍 Testing Ollama connection...")
                test_response = await self.llm.ainvoke("Hello")
                print(f"✅ Ollama connection successful")
                return True
            
        except asyncio.TimeoutError:
            print(f"❌ Ollama connection timed out")
            print(f"   Make sure Ollama is running and responsive at {self.ollama_base_url}")
            return False
            
        except Exception as e:
            print(f"❌ Failed to initialize Ollama: {e}")
            print(f"   Make sure Ollama is running and model '{self.model_name}' is available")
            print(f"   Try: ollama pull {self.model_name}")
            return False
    
    async def _create_agent(self) -> bool:
        """Create MCP agent with LLM and client, using specialized Emacs/Gendl prompt."""
        try:
            # Create specialized prompt for Emacs Lisp and Gendl tasks
            prompt = ChatPromptTemplate.from_messages([
                ("system", """
You are an AI pair programmer specialized in Emacs Lisp and Gendl (Generative Design Language).

Your primary tools include:
- emacs-mcp_lisp_eval: Execute Emacs Lisp code
- gendl-mcp_lisp_eval: Execute Gendl/GDL code  
- *_doc tools: Query documentation (use CLAUDE.md syntax guidance for Paredit, GDL plists)
- *_ping_lisp: Check server status

Guidelines:
1. Use tools iteratively to perform complex tasks
2. Query doc tools for syntax guidance when uncertain
3. Use ping_lisp to verify server connectivity before major operations
4. For shell tasks, consider using emacs lisp_eval with (shell-command ...)
5. Send outputs to *eat* buffer via (eat-term-display-output ...) when appropriate
6. If unclear about user intent, ask clarifying questions
7. Break down complex tasks into smaller, manageable steps
8. Always test your code incrementally

Focus areas:
- Emacs configuration and customization
- Lisp programming and debugging
- Gendl 3D modeling and CAD operations
- Integration between Emacs and Gendl workflows

Be precise, helpful, and educational in your responses.
                """),
                ("human", "{input}")
            ])
            
            # Check if MCPAgent supports prompt parameter
            try:
                self.agent = MCPAgent(
                    llm=self.llm,
                    client=self.client,
                    prompt=prompt,
                    max_steps=self.max_steps,
                    verbose=self.verbose
                )
            except TypeError:
                # Fallback if prompt parameter is not supported
                print("ℹ️  Using default agent (custom prompt not supported)")
                self.agent = MCPAgent(
                    llm=self.llm,
                    client=self.client,
                    max_steps=self.max_steps,
                    verbose=self.verbose
                )
            
            return True
            
        except Exception as e:
            print(f"❌ Failed to create agent: {e}")
            return False
    
    async def run_prompt_loop(self):
        """Run the interactive terminal prompt loop with timeout handling."""
        print("\n🤖 MCP Agent ready! Type your questions or commands.")
        print("   Commands: 'quit', 'exit', 'help', 'status', 'tools', 'ping'")
        print("   Use Ctrl+C to interrupt current execution\n")
        
        try:
            while True:
                try:
                    # Get user input
                    user_input = input(">>> ").strip()
                    
                    if not user_input:
                        continue
                    
                    # Handle special commands
                    if user_input.lower() in ['quit', 'exit']:
                        print("👋 Goodbye!")
                        break
                    
                    elif user_input.lower() == 'help':
                        await self._show_help()
                        continue
                    
                    elif user_input.lower() == 'status':
                        await self._show_status()
                        continue
                    
                    elif user_input.lower() == 'tools':
                        await self._show_tools()
                        continue
                    
                    elif user_input.lower() in ['ping', 'test']:
                        await self._ping_servers()
                        continue
                    
                    # Process with agent
                    print(f"\n🤔 Processing your request...")
                    
                    try:
                        # Add configurable timeout for agent execution
                        timeout = getattr(self, '_request_timeout', 300)  # Default 5 minutes
                        async with asyncio.timeout(timeout):
                            result = await self.agent.run(
                                user_input,
                                max_steps=self.max_steps
                            )
                            
                            print(f"\n🤖 Response:")
                            print(f"{result}\n")
                    
                    except asyncio.TimeoutError:
                        timeout = getattr(self, '_request_timeout', 300)
                        print(f"\n⏱️  Request timed out ({timeout}s). Try breaking it into smaller steps.\n")
                        continue
                        
                    except KeyboardInterrupt:
                        print(f"\n⚠️  Execution interrupted by user\n")
                        continue
                    
                    except Exception as e:
                        print(f"\n❌ Error processing request: {e}")
                        if self.verbose:
                            import traceback
                            print(f"Traceback: {traceback.format_exc()}")
                        print("")
                        continue
                
                except KeyboardInterrupt:
                    print(f"\n⚠️  Use 'quit' or 'exit' to leave\n")
                    continue
                
                except EOFError:
                    print(f"\n👋 Goodbye!")
                    break
        
        finally:
            await self.cleanup()
    
    async def _show_help(self):
        """Show help information."""
        print(f"""
🔧 Available Commands:
   quit, exit  - Exit the agent
   help        - Show this help message
   status      - Show agent status and server info
   tools       - Discover and list available MCP tools
   ping, test  - Test connectivity to all MCP servers
   
💡 Usage Tips:
   - Ask questions in natural language
   - Request specific server usage: "Use the gendl server to..."
   - Check server status: "ping the emacs server"
   - Get documentation: "show me gendl documentation"
   - Execute code: "run this lisp code in emacs"
   
⚙️  Current Configuration:
   - Model: {self.model_name}
   - Max steps: {self.max_steps}
   - Timeout: 5 minutes per request
   
🎯 Specialized for:
   - Emacs Lisp programming and configuration
   - Gendl 3D modeling and CAD operations
   - Integration workflows between Emacs and Gendl
        """)

    async def _ping_servers(self):
        """Test connectivity to all MCP servers."""
        print(f"\n🏓 Testing server connectivity...")

        for server_name in self.client.config.get('mcpServers', {}):
            try:
                print(f"   Testing {server_name}...", end=" ")
                async with asyncio.timeout(10):
                    # Ensure session exists
                    if server_name not in self.client.sessions:
                        print(f"\n   ⚠ No session for {server_name}. Attempting to initialize...")
                        try:
                            if hasattr(self.client, 'initialize_session'):
                                await self.client.initialize_session(server_name)
                                print(f"   Session initialized for {server_name}")
                            else:
                                print(f"   ❌ MCPClient does not support initialize_session method")
                                continue
                        except Exception as e:
                            print(f"   ❌ Failed to initialize session: {e}")
                            continue
                        
                        # Direct tool call
                        tool_name = f"{server_name}__ping_lisp"
                        if server_name in self.client.sessions:
                            session = self.client.sessions[server_name]
                            if hasattr(session, 'call_tool'):
                                tool_result = await session.call_tool(tool_name, {})
                                print(f"\n   [DEBUG] Direct tool result: {tool_result}")
                                # Handle structured tool result
                                tool_result_text = tool_result
                                if isinstance(tool_result, dict):
                                    content = tool_result.get('content', [])
                                    if content and isinstance(content, list) and len(content) > 0:
                                        tool_result_text = content[0].get('text', str(tool_result))
                                        if isinstance(tool_result_text, str) and "pong" in tool_result_text.lower():
                                            print("✅ OK")
                                        else:
                                            print(f"⚠ Unknown status")
                                            print(f"   Direct Result: {tool_result_text}")
                                    else:
                                        print(f"⚠ Session for {server_name} does not support tool calls")
                                else:
                                    print(f"⚠ No session for {server_name} after initialization attempt")
                                    
            except asyncio.TimeoutError:
                print("⏱ Timeout")
            except Exception as e:
                print(f"❌ Error: {e}")            
        

    async def _show_status(self):
        """Show detailed agent status."""
        if not self.client or not self.agent:
            print("❌ Agent not initialized")
            return
        
        print(f"""
📊 Agent Status:
   Model: {self.model_name}
   Ollama URL: {self.ollama_base_url}
   Max Steps: {self.max_steps}
   Verbose: {self.verbose}
   Config: {self.config_path}
   
🔌 MCP Servers Configuration:
        """)
        
        for server_name, config in self.client.config.get('mcpServers', {}).items():
            print(f"   📦 {server_name}:")
            if 'command' in config:
                print(f"      Command: {config['command']} {' '.join(config.get('args', []))}")
            if 'url' in config:
                print(f"      URL: {config['url']}")
            
            # Show session status if available
            if hasattr(self.client, 'sessions'):
                if server_name in self.client.sessions:
                    print(f"      Status: ✅ Session active")
                else:
                    print(f"      Status: ⚪ Not connected")
            print("")
        
        # Show memory usage info if available
        try:
            import psutil
            process = psutil.Process()
            memory_mb = process.memory_info().rss / 1024 / 1024
            print(f"💾 Memory Usage: {memory_mb:.1f} MB")
        except ImportError:
            pass
        
        print(f"🎯 Specialization: Emacs Lisp + Gendl 3D Modeling")
    
    async def _show_tools(self) -> bool:
        """Show available MCP tools with dynamic discovery."""
        try:
            print(f"\n🔧 Discovering available tools...")
            all_tools = []
            
            # Try to get tools from each server
            for server_name in self.client.config.get('mcpServers', {}):
                try:
                    print(f"\n📦 Server: {server_name}")
                    
                    # Check if client has sessions and tools available
                    if hasattr(self.client, 'sessions') and server_name in self.client.sessions:
                        session = self.client.sessions[server_name]
                        
                        # Try different methods to get tools based on MCP client implementation
                        tools = []
                        if hasattr(session, 'list_tools'):
                            tools_response = await session.list_tools()
                            tools = tools_response.tools if hasattr(tools_response, 'tools') else []
                        elif hasattr(session, 'get_tools'):
                            tools = await session.get_tools()
                        
                        if tools:
                            for tool in tools:
                                tool_name = tool.name if hasattr(tool, 'name') else str(tool)
                                description = tool.description if hasattr(tool, 'description') else 'No description'
                                print(f"   • {tool_name}: {description}")
                                all_tools.append((server_name, tool_name, description))
                        else:
                            print(f"   ℹ️  No tools found or server not initialized")
                            
                    else:
                        print(f"   ⚠️  Server session not available (may need to make a request first)")
                        
                except Exception as e:
                    print(f"   ❌ Error accessing {server_name}: {e}")
                    continue
            
            if not all_tools:
                print(f"\n💡 No tools discovered yet. This is normal if servers haven't been used.")
                print(f"   Tools will become available after the first request to each server.")
                print(f"   Try asking: 'What can you do with the gendl server?'")
            else:
                print(f"\n✅ Found {len(all_tools)} tools across {len(set(t[0] for t in all_tools))} servers")
            
            print(f"\n💡 Usage Tips:")
            print(f"   • Use natural language: 'Use gendl to create a cube'")
            print(f"   • Check server status: 'ping the gendl server'")
            print(f"   • Get help: 'show me gendl documentation'")
            
            return len(all_tools) > 0
            
        except Exception as e:
            print(f"❌ Error discovering tools: {e}")
            print(f"💡 This may be normal - tools are often discovered dynamically during use")
            return False
    
    async def cleanup(self):
        """Clean up resources."""
        if self.client:
            try:
                await self.client.close_all_sessions()
                print("🧹 Cleaned up MCP sessions")
            except Exception as e:
                print(f"⚠️  Error during cleanup: {e}")


async def main():
    """Main entry point."""
    import argparse
    
    parser = argparse.ArgumentParser(
        description="Ollama MCP Terminal Agent - Specialized for Emacs Lisp and Gendl",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  %(prog)s                              # Use defaults with mcp-config.json
  %(prog)s -m mistral -v                # Use mistral model with verbose output  
  %(prog)s -c custom.json -s 20         # Custom config with 20 max steps
  %(prog)s --model codellama --debug    # Use codellama with full debug output
  
Supported Models:
  llama3.2, llama3.1, llama2, mistral, codellama, deepseek-coder, etc.
  (Any model available in your local Ollama installation)
        """
    )
    
    parser.add_argument("--config", "-c", default="mcp-config.json",
                       help="Path to MCP config file (default: mcp-config.json)")
    parser.add_argument("--model", "-m", default="llama3.2",
                       help="Ollama model name (default: llama3.2)")
    parser.add_argument("--ollama-url", "-u", default="http://localhost:11434",
                       help="Ollama server URL (default: http://localhost:11434)")
    parser.add_argument("--max-steps", "-s", type=int, default=10,
                       help="Maximum agent steps (default: 10)")
    parser.add_argument("--verbose", "-v", action="store_true",
                       help="Enable verbose output")
    parser.add_argument("--debug", "-d", action="store_true",
                       help="Enable debug mode (implies verbose)")
    parser.add_argument("--timeout", "-t", type=int, default=300,
                       help="Request timeout in seconds (default: 300)")
    parser.add_argument("--no-prompt", action="store_true",
                       help="Skip the specialized Emacs/Gendl prompt")
    
    args = parser.parse_args()
    
    # Load environment variables
    load_dotenv()
    
    # Enable debug mode if requested
    if args.debug:
        import mcp_use
        mcp_use.set_debug(2)
    
    # Create and initialize agent
    agent = OllamaMCPAgent(
        config_path=args.config,
        model_name=args.model,
        ollama_base_url=args.ollama_url,
        max_steps=args.max_steps,
        verbose=args.verbose or args.debug
    )
    
    # Override specialized prompt if requested
    if args.no_prompt:
        agent._use_specialized_prompt = False
    
    print(f"🚀 Starting Ollama MCP Agent...")
    print(f"   Config: {args.config}")
    print(f"   Model: {args.model}")
    print(f"   Ollama: {args.ollama_url}")
    print(f"   Max Steps: {args.max_steps}")
    print(f"   Timeout: {args.timeout}s")
    
    # Initialize agent
    if not await agent.initialize():
        print(f"\n💡 Troubleshooting tips:")
        print(f"   • Make sure Ollama is running: ollama serve")
        print(f"   • Check if model exists: ollama list")
        print(f"   • Pull model if needed: ollama pull {args.model}")
        print(f"   • Verify MCP config file exists and is valid")
        print(f"   • Check MCP server processes are accessible")
        sys.exit(1)
    
    # Store timeout for use in prompt loop
    agent._request_timeout = args.timeout
    
    # Run prompt loop
    await agent.run_prompt_loop()


if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        print(f"\n👋 Agent stopped by user")
    except Exception as e:
        print(f"❌ Fatal error: {e}")
        sys.exit(1)
